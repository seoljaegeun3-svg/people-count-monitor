{
  "name": "people-count-monitor",
  "version": "1.3.5",
  "private": true,
  "description": "카메라 통행 인원과 PLC 비교·확인 구간 MP4 녹화",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:camera": "electron scripts/camera-smoke.cjs",
    "test:packaged": "node scripts/verify-packaged.cjs",
    "dist:win": "electron-builder --win portable --x64",
    "verify:model": "node scripts/verify-person-model.cjs",
    "test:plc-display": "electron scripts/plc-display-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kr.peoplecount.monitor",
    "productName": "People Count Monitor",
    "files": [
      "main.js",
      "preload.js",
      "plc.js",
      "web-url.js",
      "recording.js",
      "auto-recording.js",
      "motion.js",
      "vision-review.js",
      "person-detector.js",
      "people-counter.js",
      "passage-comparison.js",
      "comparison-config.js",
      "models/**",
      "mp4.js",
      "ui/**",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*",
      "node_modules/onnxruntime-node/bin/**"
    ],
    "win": {
      "target": "portable"
    },
    "artifactName": "People-Count-Monitor-${version}.${ext}"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "onnxruntime-node": "1.23.2"
  }
}
